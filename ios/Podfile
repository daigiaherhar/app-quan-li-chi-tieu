platform :ios, '15.5'

$iOSVersion = '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
require File.expand_path(
  '.symlinks/plugins/google_mlkit_commons/ios/scripts/apple_silicon_simulator',
  __dir__,
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=*]'] = 'armv7'
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      deployment_target =
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || $iOSVersion
      next unless Gem::Version.new($iOSVersion) > Gem::Version.new(deployment_target)

      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
    end
  end

  # Relabel ML Kit arm64 device slices for Apple Silicon iOS 26+ simulators.
  mlkit_apple_silicon_simulator_patch(installer)
  install_mlkit_patch_on_runner(installer)
end

# Pods-Runner script phases can be skipped by Flutter's xcodebuild path.
# Also attach the patcher to the Runner target so simulator/device builds always
# relabel ML Kit before linking.
def install_mlkit_patch_on_runner(installer)
  phase_name = '[ML Kit] Relabel arm64 slice for current platform'
  script = <<~'SH'
    set -euo pipefail
    : "${PLATFORM_NAME:?PLATFORM_NAME is not set}"
    : "${PODS_ROOT:?PODS_ROOT is not set}"
    PATCHER="${PODS_ROOT}/MLKitAppleSiliconSimulator/patch_arm64_simulator.py"
    if [ ! -f "$PATCHER" ]; then
      echo "warning: ML Kit Apple Silicon patcher missing at $PATCHER"
      exit 0
    fi
    /usr/bin/env python3 "$PATCHER" \
      --platform "${PLATFORM_NAME}" \
      --pods-root "${PODS_ROOT}"
  SH

  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    user_project.targets.each do |user_target|
      next unless user_target.name == 'Runner'

      phase = user_target.shell_script_build_phases.find { |p| p.name == phase_name }
      phase ||= user_target.new_shell_script_build_phase(phase_name)
      phase.shell_path = '/bin/sh'
      phase.shell_script = script
      phase.always_out_of_date = '1' if phase.respond_to?(:always_out_of_date=)

      build_phases = user_target.build_phases
      build_phases.delete(phase)
      build_phases.unshift(phase)
      user_project.save
    end
  end
end

post_integrate do |installer|
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_targets.each do |user_target|
      framework_name = "Pods_#{user_target.name.gsub('-', '_')}.framework"

      user_target.frameworks_build_phase.files.to_a.each do |build_file|
        file_ref = build_file.file_ref
        next unless file_ref && file_ref.path == framework_name

        build_file.remove_from_project
      end

      user_target.project.frameworks_group.files.to_a.each do |file_ref|
        next unless file_ref.path == framework_name

        file_ref.remove_from_project
      end

      user_target.project.save
    end
  end
end
